# Build stage
#
# Pinned to the same Erlang the rest of the project builds on. The floating
# `elixir:1.20.4` tag tracks whichever OTP the image is rebuilt against, which
# silently moved this image a major release ahead of every other target. The
# Debian release is pinned to trixie to match the runtime stage below, so the
# bundled ERTS links against the same OpenSSL and ncurses it will find there.
FROM hexpm/elixir:1.20.4-erlang-28.5.0.7-debian-trixie-20260918-slim AS build

# Avoid prompts from apt and configure debconf
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NONINTERACTIVE_SEEN=true

# Set the locale to UTF-8
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Configure debconf and install build dependencies
RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections && \
    apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    autoconf \
    m4 \
    libncurses5-dev \
    libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Set build ENV early (before any mix commands)
ENV MIX_ENV=prod \
    NODE_ENV=production \
    DEPLOYMENT_TYPE=docker

# Copy mix files and config (build context is the repository root)
COPY mix.exs mix.lock ./
COPY config ./config

# Get dependencies using committed lock file
RUN mix deps.get --only prod

# Copy the rest of the application code. Wipe any locally-built assets first
# so the image build is hermetic — assets are always produced by mix assets.deploy
# below, never snuck in from the developer's local priv/static/assets/ directory.
COPY . .
RUN rm -rf priv/static/assets/

# Airfibers fork: pre-seed the mjml NIF cache before compiling.
#
# mjml ships a precompiled NIF that rustler_precompiled downloads from GitHub
# Releases at compile time. That download runs through Erlang's :httpc, which
# caps response headers at 10KB; GitHub's redirect response now carries a
# Content-Security-Policy header larger than that, so the fetch fails with
# `{:error, {:header_too_long, {:max, 10240}}}` and the build dies. curl has no
# such limit, so fetch the artifact here and drop it where rustler_precompiled
# looks first. It verifies the file against the checksum compiled into mjml
# (sha256 442c88cf... in mjml's checksum-Elixir.Mjml.Native.exs), so a bad or
# tampered download still fails the build rather than being used.
#
# This keeps the lockfile and dependency tree untouched: no rustler, no Rust
# toolchain, no source build. Bump the version and checksum together with mjml.
#
# Note the file goes DIRECTLY in the cache path, with no `precompiled_nifs/`
# subdirectory: when RUSTLER_PRECOMPILED_GLOBAL_CACHE_PATH is set,
# rustler_precompiled's cache_dir/1 returns it as-is and skips the subdirectory
# it would otherwise append. A file in a subdirectory is ignored and the
# download is attempted anyway.
ENV RUSTLER_PRECOMPILED_GLOBAL_CACHE_PATH=/root/.cache/rustler_precompiled
RUN mkdir -p "$RUSTLER_PRECOMPILED_GLOBAL_CACHE_PATH" && \
    curl -fsSL --retry 5 --retry-delay 5 \
        -o "$RUSTLER_PRECOMPILED_GLOBAL_CACHE_PATH/libmjml_nif-v6.0.0-nif-2.16-x86_64-unknown-linux-gnu.so.tar.gz" \
        "https://github.com/adoptoposs/mjml_nif/releases/download/v6.0.0/libmjml_nif-v6.0.0-nif-2.16-x86_64-unknown-linux-gnu.so.tar.gz" && \
    echo "442c88cfe5e4f5d01698eaebbee4b2f9526ba60b9231ff43ea621edd66e2927c  $RUSTLER_PRECOMPILED_GLOBAL_CACHE_PATH/libmjml_nif-v6.0.0-nif-2.16-x86_64-unknown-linux-gnu.so.tar.gz" | sha256sum -c -

# Airfibers fork: pre-seed the vix/libvips tarball before compiling.
#
# Same root cause as mjml above, different dependency. vix (pulled in by
# :image) downloads sharp-libvips from GitHub Releases at compile time using
# Erlang's :httpc, which caps response headers at 10KB, so it fails with
# `{:error, {:header_too_long, {:max, 10240}}}`. vix has no cache directory to
# seed: its c_src/Makefile runs build_scripts/precompiler.exs, which always
# downloads. So fetch the tarball with curl and make the precompiler's
# download/2 a no-op that returns the file already in place.
#
# The patch is applied to deps/vix AFTER `mix deps.get` and BEFORE
# `mix deps.compile`, which is the only window where it takes effect. It fails
# loudly if the expected source is not found, so a vix upgrade that changes
# the script breaks the build instead of silently downloading again.
#
# Unlike mjml, vix does not verify a checksum, so the sha256 is pinned here to
# keep the build reproducible. Bump the release tag, filename and checksum
# together when vix moves.
ENV VIX_LIBVIPS_TARBALL=sharp-libvips-linux-x64.tar.gz
RUN mkdir -p /tmp/vix-libvips && \
    curl -fsSL --retry 5 --retry-delay 5 \
        -o "/tmp/vix-libvips/$VIX_LIBVIPS_TARBALL" \
        "https://github.com/akash-akya/sharp-libvips/releases/download/v8.18.7-rc1/$VIX_LIBVIPS_TARBALL" && \
    echo "9273ce56de05b0f5e896056fe36aeb31483db7ba8baa1f4dc65fd93e92d0589c  /tmp/vix-libvips/$VIX_LIBVIPS_TARBALL" | sha256sum -c -

# Rewrite vix's download/2 so it copies the pre-fetched tarball instead of
# fetching it. awk is used because the replacement spans several lines and
# sed's \n handling differs between implementations. The grep asserts the
# expected source line exists, so a vix upgrade that changes the script fails
# the build instead of silently downloading again.
RUN set -e; \
    f=deps/vix/build_scripts/precompiler.exs; \
    grep -qF '  def download(url, path) do' "$f"; \
    awk '/^  def download\(url, path\) do$$/ { \
            print "  def download(_url, path) do"; \
            print "    # Airfibers fork: tarball pre-fetched by the Dockerfile with curl, because"; \
            print "    # Erlang :httpc cannot follow GitHub redirects (headers exceed the 10KB cap)."; \
            print "    File.mkdir_p!(Path.dirname(path))"; \
            print "    File.cp!(System.fetch_env!(\"VIX_LIBVIPS_TARBALL_PATH\"), path)"; \
            print "    {:ok, path}"; \
            print "  end"; \
            print ""; \
            print "  defp download_orig(url, path) do"; \
            next \
         } \
         { print }' "$f" > "$f.new"; \
    mv "$f.new" "$f"; \
    grep -qF '  defp download_orig(url, path) do' "$f"; \
    echo "patched $f"

# Compile dependencies and application code
RUN VIX_LIBVIPS_TARBALL_PATH="/tmp/vix-libvips/$VIX_LIBVIPS_TARBALL" \
    mix do deps.compile + compile

# Install Tailwind and esbuild with retry mechanism
RUN for i in 1 2 3 4 5; do \
        echo "Attempt $i: Installing tailwind and esbuild" && \
        mix do tailwind.install + esbuild.install && break || sleep 5; \
    done  

# Compile assets
RUN mix assets.deploy

# Create the release. mix release embeds config/runtime.exs in the release
# itself, so no extra copy is needed.
RUN mix release tymeslot

# Slim production stage — debian only, no Elixir SDK, no PostgreSQL server.
# The release bundles its own ERTS. postgresql-client is kept for pg_isready,
# which the entrypoint uses to wait for the external database.
FROM debian:trixie-slim AS release-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libssl3 \
    libncurses6 \
    ca-certificates \
    locales \
    tzdata \
    ffmpeg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Locale and timezone
RUN locale-gen C.UTF-8 && update-locale LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN ln -fs /usr/share/zoneinfo/UTC /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata

# App user and data directories
RUN useradd --create-home --shell /bin/bash app && \
    mkdir -p /app /app/data /app/data/uploads && \
    chown -R app:app /app

WORKDIR /app

# Copy the release from build stage
COPY --from=build --chown=app:app /app/_build/prod/rel/tymeslot ./

# Copy start script and the .env reader it sources
COPY --chown=app:app start-docker.sh /app/start-docker.sh
COPY --chown=app:app scripts/dotenv-reader.sh /app/dotenv-reader.sh
RUN chmod +x /app/start-docker.sh

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MIX_ENV=prod \
    DEPLOYMENT_TYPE=docker \
    PHX_SERVER=true \
    PORT=4000 \
    TYMESLOT_EMBEDDED_DB=false

EXPOSE 4000

VOLUME ["/app/data"]

# The entrypoint runs as root to set up /app/data, then drops to the app user
# for the Elixir process.
USER root

CMD ["/app/start-docker.sh"]

# Default production stage — the slim image plus an embedded PostgreSQL server.
# This stage is last, so `docker build` without --target still produces the
# batteries-included image every existing self-hoster runs.
FROM release-slim AS release

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql \
    postgresql-contrib \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/lib/postgresql/data && \
    chown -R postgres:postgres /var/lib/postgresql && \
    chmod 700 /var/lib/postgresql/data

ENV TYMESLOT_EMBEDDED_DB=true

VOLUME ["/app/data", "/var/lib/postgresql/data"]
